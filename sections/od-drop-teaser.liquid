{% comment %}
  od-drop-teaser
  Test 1 · Drop teaser — 1440 × 567, two panels.

  Left  : patterned background, script headline, live countdown built from digit tiles.
  Right : image card with an overlaid serif caption and a "Get notified" email capture.

  Geometry from the Figma (node 917:1265):
    section  1440 x 567, 24px padding
    panels   692 x 519 each, 8px apart, 4px radius
    left     #421802, 20px padding, 48px between headline block and countdown
    right    #fffbf8, 1px rgba(66,24,2,.1) border, 24px padding
    tiles    46.5 wide, rounded 3.3, white @85%, Inter Bold 19.9 in #421802
    labels   La Belle Aurore 24px, white
    caption  Instrument Serif Italic 72px, white

  The email capture posts through Shopify's own {% form 'customer' %} (tagged
  "newsletter"), so signups land in Customers in the admin with no app and no
  third-party endpoint. Success and error states are rendered from Liquid on the
  round trip, and validated client-side first so a typo never costs a page load.

  Countdown behaviour at zero is a merchant setting — see "When the countdown ends".
{% endcomment %}

{{ 'od-base.css' | asset_url | stylesheet_tag }}
{{ 'od-drop-teaser.css' | asset_url | stylesheet_tag }}
{% render 'od-fonts' %}
<script src="{{ 'od-countdown.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings

  # Shopify stores the datetime picker value as "YYYY-MM-DD HH:MM". We hand the
  # raw value plus the shop's UTC offset to the browser and let it do the maths,
  # so the deadline means the same instant for every visitor regardless of where
  # they are. Without the offset a shopper in Tokyo sees a different countdown
  # from one in Berlin.
  assign deadline_raw = s.deadline | default: ''
  assign deadline_iso = deadline_raw | replace: ' ', 'T'

  assign form_id = 'od-teaser-signup-' | append: section.id
-%}

<section
  class="od-section od-teaser od-teaser--script-{{ s.script_face | default: 'design' }}"
  id="od-teaser-{{ section.id }}"
  style="
    --od-teaser-floor: {{ s.min_panel_height }}px;
    --od-teaser-gap: {{ s.panel_gap }}px;
    --od-teaser-pad: {{ s.section_padding }}px;
    --od-teaser-split: {{ s.split_ratio }}%;
    --od-teaser-left-bg: {{ s.left_background_color }};
    --od-teaser-left-ink: {{ s.left_text_color }};
    --od-teaser-script-ink: {{ s.script_color }};
    --od-teaser-pattern-size: {{ s.pattern_size }}px;
    --od-teaser-pattern-opacity: {{ s.pattern_opacity | divided_by: 100.0 }};

    --od-teaser-tile-bg: {{ s.tile_background }};
    --od-teaser-tile-ink: {{ s.tile_text_color }};
    --od-teaser-right-bg: {{ s.right_background_color }};
  "
>
  <div class="od-teaser__panels">
  {%- comment -%} ── Left panel ─────────────────────────────────────────── {%- endcomment -%}
  {%- liquid
    # The pattern is the panel's own background rather than a layer on top of
    # it: one element instead of two, no stacking order to get wrong, and the
    # url is quoted so a filename with spaces or brackets can't break it.
    # Falls back to the bundled line art, so the panel looks designed the moment
    # the section is added rather than flat brown. It is stroke-only SVG at 2.4KB
    # — cheaper than any raster and crisp at any size.
    assign pattern_url = 'od-pattern-bows.svg' | asset_url
    if s.pattern_image != blank
      assign pattern_url = s.pattern_image | image_url: width: 1600
    endif

    # "Pattern strength" without an opacity layer: a flat wash of the panel
    # colour is composited over the image, so 100% shows the art untouched and
    # lower values sink it into the panel. Opacity on a wrapper would have
    # faded the panel colour too.
    assign tint_alpha = 100 | minus: s.pattern_opacity | divided_by: 100.0
    assign tint = s.left_background_color | color_modify: 'alpha', tint_alpha

    # An empty colour setting would make color_modify return nothing, which
    # would invalidate the whole background-image and drop the pattern with it.
    assign pattern_layers = "url('" | append: pattern_url | append: "')"
    if tint != blank
      assign pattern_layers = 'linear-gradient(' | append: tint | append: ', ' | append: tint | append: '), ' | append: pattern_layers
    endif
  -%}
  <div
    class="od-teaser__panel od-teaser__panel--left od-teaser__panel--{{ s.pattern_fit }}"
    {% if pattern_url != blank %}
      style="background-image: {{ pattern_layers }};"
    {% endif %}
  >
    {%- comment -%}
      ── Watermark letter ──
      The design sets a single huge Pinyon Script glyph at 7% white behind the
      content. Because that face is bundled, this is real text in CSS rather
      than another image to export — it costs no request and stays crisp at any
      size. Hidden from assistive tech: it is texture, not content.
    {%- endcomment -%}
    {%- if s.watermark_letter != blank -%}
      <span
        class="od-teaser__watermark"
        aria-hidden="true"
        style="--od-watermark-opacity: {{ s.watermark_opacity | divided_by: 100.0 }};"
      >{{ s.watermark_letter | escape }}</span>
    {%- endif -%}

    <div class="od-teaser__left-content">
      {%- if s.eyebrow != blank -%}
        <p class="od-teaser__eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.script_headline != blank -%}
        <h2 class="od-teaser__script">{{ s.script_headline }}</h2>
      {%- endif -%}

      {%- if deadline_iso != blank -%}
        <od-countdown
          class="od-countdown"
          data-deadline="{{ deadline_iso }}"
          data-utc-offset="{{ 'now' | date: '%z' }}"
          data-on-expire="{{ s.expired_behavior }}"
          data-section-id="{{ section.id }}"
        >
          <div class="od-countdown__units" data-countdown-units>
            {%- comment -%}
              Units are rendered server-side from the merchant's choice so the
              markup is complete before JS runs — no layout shift, and the tiles
              are already in the DOM for the theme editor to measure.

              Label wording note: the Figma labels the four groups
              DAYS / HOURS / MINUTES / SECONDS but the third tile group only has
              room for two digits at a "MINS" width. The labels are merchant
              settings here so the built version can match the design exactly
              once the copy is settled — see the README.
            {%- endcomment -%}
            {%- assign unit_keys = 'days,hours,minutes,seconds' | split: ',' -%}
            {%- for unit in unit_keys -%}
              {%- liquid
                case unit
                  when 'days'
                    assign label = s.label_days
                    assign enabled = s.show_days
                  when 'hours'
                    assign label = s.label_hours
                    assign enabled = true
                  when 'minutes'
                    assign label = s.label_minutes
                    assign enabled = true
                  when 'seconds'
                    assign label = s.label_seconds
                    assign enabled = s.show_seconds
                endcase
              -%}
              {%- if enabled -%}
                <div class="od-countdown__unit" data-unit="{{ unit }}">
                  <div class="od-countdown__tiles">
                    <span class="od-countdown__tile" data-digit="0">0</span>
                    <span class="od-countdown__tile" data-digit="1">0</span>
                  </div>
                  {%- if label != blank -%}
                    <span class="od-countdown__label">{{ label | escape }}</span>
                  {%- endif -%}
                </div>
                {%- unless forloop.last -%}
                  {%- comment -%}
                    The design's separator is two 4px white squares, not a colon
                    glyph — so it is drawn, not typed.
                  {%- endcomment -%}
                  <span class="od-countdown__sep" aria-hidden="true">
                    <i></i><i></i>
                  </span>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%}
            Digit tiles are hidden from assistive tech (they read as loose
            numbers). This region carries the same information as a sentence and
            updates once a minute, which is informative without being a torrent.
          {%- endcomment -%}
          <p class="od-visually-hidden" data-countdown-announcer role="status" aria-live="polite"></p>

          <p class="od-countdown__expired" data-countdown-expired hidden>
            {{ s.expired_message | escape }}
            {%- if s.expired_link_label != blank and s.expired_link != blank %}
              <a class="od-teaser__expired-link" href="{{ s.expired_link }}">{{ s.expired_link_label | escape }}</a>
            {%- endif -%}
          </p>
        </od-countdown>
      {%- elsif request.design_mode -%}
        <p class="od-teaser__editor-hint">Set the drop date and time to start the countdown.</p>
      {%- endif -%}

      {%- if s.left_body != blank -%}
        <div class="od-teaser__left-body rte">{{ s.left_body }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── Right panel ────────────────────────────────────────── {%- endcomment -%}
  <div class="od-teaser__panel od-teaser__panel--right">
    <div class="od-teaser__card">
      {%- if s.card_image != blank -%}
        <img
          src="{{ s.card_image | image_url: width: 720 }}"
          srcset="
            {{ s.card_image | image_url: width: 480 }} 480w,
            {{ s.card_image | image_url: width: 720 }} 720w,
            {{ s.card_image | image_url: width: 1440 }} 1440w
          "
          sizes="(min-width: 990px) 50vw, 100vw"
          width="{{ s.card_image.width }}"
          height="{{ s.card_image.height }}"
          alt="{{ s.card_image.alt | escape }}"
          class="od-teaser__card-image"
          loading="lazy"
        >
      {%- else -%}
        <div class="od-teaser__card-image od-teaser__card-image--placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'od-teaser__placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if s.card_caption != blank -%}
        <p class="od-teaser__caption">{{ s.card_caption }}</p>
      {%- endif -%}
    </div>

    <div class="od-teaser__signup" id="{{ form_id }}">

      {%- form 'customer', id: form_id, class: 'od-teaser__form', novalidate: 'novalidate' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- comment -%}
          Shopify redirects back to the page the form was posted from with
          ?customer_posted=true. The anchor brings the shopper back to the form
          rather than the top of the page, so the success message is on screen.
        {%- endcomment -%}
        <input type="hidden" name="return_to" value="{{ request.path }}?customer_posted=true#{{ form_id }}">

        {%- if form.posted_successfully? -%}
          <p class="od-teaser__state od-teaser__state--success" role="status" tabindex="-1" data-signup-success>
            <span aria-hidden="true">✓</span> {{ s.success_message | escape }}
          </p>
        {%- else -%}
          {%- comment -%}
            "Get notified" is the field's own visible <label>, not a heading —
            it labels one input, and making it an h3 would put a heading in the
            page outline for a form field.
          {%- endcomment -%}
          <label class="od-teaser__signup-label" for="{{ form_id }}-email">
            {{ s.signup_heading | escape }}
          </label>

          {%- if s.signup_body != blank -%}
            <p class="od-teaser__signup-body">{{ s.signup_body | escape }}</p>
          {%- endif -%}

          <div class="od-teaser__field">
            <input
              id="{{ form_id }}-email"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ s.email_label | escape }}"
              autocomplete="email"
              required
              spellcheck="false"
              class="od-teaser__input"
              {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
            >
            <button type="submit" class="od-teaser__submit">
              {{ s.signup_button_label | escape }}
            </button>
          </div>

          {%- comment -%}
            One error node serves both sources: Shopify's server-side errors on
            load, and the client-side validation message before submit.
          {%- endcomment -%}
          <p
            class="od-teaser__state od-teaser__state--error"
            id="{{ form_id }}-error"
            role="alert"
            data-signup-error
            data-default-message="{{ s.error_message | escape }}"
            {% unless form.errors %}hidden{% endunless %}
          >
            {%- if form.errors -%}
              {{ form.errors.messages['email'] | default: s.error_message | escape }}
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Drop teaser",
  "tag": "section",
  "class": "od-section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Countdown" },
    {
      "type": "text",
      "id": "deadline",
      "label": "Drop date and time",
      "default": "2026-12-01 10:00",
      "info": "Format: YYYY-MM-DD HH:MM, in your store's timezone (set under Settings → General)."
    },
    {
      "type": "select",
      "id": "expired_behavior",
      "label": "When the countdown ends",
      "options": [
        { "value": "message", "label": "Replace the timer with a message" },
        { "value": "zero", "label": "Keep the timer showing all zeros" },
        { "value": "hide", "label": "Hide this section entirely" }
      ],
      "default": "message"
    },
    { "type": "text", "id": "expired_message", "label": "Message when it ends", "default": "The drop is live." },
    { "type": "text", "id": "expired_link_label", "label": "Link label when it ends", "default": "Shop now" },
    { "type": "url", "id": "expired_link", "label": "Link when it ends" },
    { "type": "checkbox", "id": "show_days", "label": "Show days", "default": true },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Show seconds",
      "default": false,
      "info": "The design shows three groups. Turning this on adds a fourth."
    },
    { "type": "text", "id": "label_days", "label": "Label under days", "default": "Days" },
    { "type": "text", "id": "label_hours", "label": "Label under hours", "default": "Hours" },
    { "type": "text", "id": "label_minutes", "label": "Label under minutes", "default": "Minutes" },
    { "type": "text", "id": "label_seconds", "label": "Label under seconds", "default": "Seconds" },

    { "type": "header", "content": "Left panel" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the headline" },
    { "type": "text", "id": "script_headline", "label": "Script headline", "default": "New drop coming soon" },
    { "type": "color", "id": "script_color", "label": "Script headline colour", "default": "#fffbf8" },
    {
      "type": "select",
      "id": "script_face",
      "label": "Script font",
      "options": [
        { "value": "design", "label": "La Belle Aurore (matches the design)" },
        { "value": "theme", "label": "Use the theme's heading font" }
      ],
      "default": "design",
      "info": "La Belle Aurore is bundled with the theme. Switch to the theme font to drop it."
    },
    { "type": "richtext", "id": "left_body", "label": "Supporting text" },
    {
      "type": "image_picker",
      "id": "pattern_image",
      "label": "Background pattern",
      "info": "Leave empty to use the bundled bow line art."
    },
    {
      "type": "select",
      "id": "pattern_fit",
      "label": "How the pattern fills the panel",
      "options": [
        { "value": "cover", "label": "Fill the panel (matches the design)" },
        { "value": "tile", "label": "Repeat as a tile" }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "watermark_letter",
      "label": "Watermark letter",
      "default": "A",
      "info": "One large script letter behind the content, as in the design. Leave empty to remove it."
    },
    {
      "type": "range",
      "id": "watermark_opacity",
      "label": "Watermark strength",
      "min": 0, "max": 30, "step": 1, "unit": "%", "default": 7
    },
    {
      "type": "range",
      "id": "pattern_size",
      "label": "Pattern tile size",
      "info": "Only used when the pattern repeats as a tile.",
      "min": 40, "max": 400, "step": 10, "unit": "px", "default": 160
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "label": "Pattern strength",
      "min": 5, "max": 100, "step": 5, "unit": "%", "default": 35,
      "info": "Low values sink the pattern into the panel colour. Use 100% only for thin line art that won't compete with the text."
    },
    { "type": "color", "id": "left_background_color", "label": "Left panel colour", "default": "#421802" },
    { "type": "color", "id": "left_text_color", "label": "Left panel text colour", "default": "#fffbf8" },
    { "type": "color", "id": "tile_background", "label": "Countdown tile colour", "default": "#ffffff" },
    { "type": "color", "id": "tile_text_color", "label": "Countdown number colour", "default": "#421802" },

    { "type": "header", "content": "Right panel" },
    { "type": "image_picker", "id": "card_image", "label": "Image" },
    { "type": "text", "id": "card_caption", "label": "Caption over the image", "default": "Sneak peek…" },
    { "type": "color", "id": "right_background_color", "label": "Right panel colour", "default": "#fffbf8" },

    { "type": "header", "content": "Email capture" },
    { "type": "text", "id": "signup_heading", "label": "Label above the email field", "default": "Get notified" },
    { "type": "text", "id": "signup_body", "label": "Supporting line" },
    { "type": "text", "id": "email_label", "label": "Email field placeholder", "default": "Email address" },
    { "type": "text", "id": "signup_button_label", "label": "Button label", "default": "Notify me" },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message after signing up",
      "default": "You're on the list. We'll email you when it drops."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Message when the email is invalid",
      "default": "Enter a valid email address."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "min_panel_height",
      "label": "Smallest panel height",
      "min": 300, "max": 800, "step": 10, "unit": "px", "default": 420,
      "info": "The panels grow with the window and with their content. This is the floor they never go below."
    },
    {
      "type": "range",
      "id": "panel_gap",
      "label": "Space between the panels",
      "min": 0, "max": 48, "step": 2, "unit": "px", "default": 8
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Space around the panels",
      "min": 0, "max": 64, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "split_ratio",
      "label": "Width of the left panel",
      "min": 30, "max": 70, "step": 5, "unit": "%", "default": 50
    }
  ],
  "presets": [{ "name": "Drop teaser" }]
}
{% endschema %}
